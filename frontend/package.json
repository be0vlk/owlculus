{
    "name": "owlculus",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.19.0",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "../scripts/test-first-run-browser-journey.sh",
        "test:e2e:playwright": "playwright test",
        "lint": "eslint . --fix",
        "lint:css": "stylelint 'src/**/*.{css,scss,vue}' --fix",
        "format": "prettier --write src/",
        "test:audit": "vitest run --config vitest.audit.config.js",
        "test:coverage:audit": "vitest run --config vitest.audit.config.js --coverage"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "@noble/hashes": "2.0.1",
        "@tiptap/extension-highlight": "3.31.3",
        "@tiptap/extension-list": "3.31.3",
        "@tiptap/extensions": "3.31.3",
        "@tiptap/pm": "3.31.3",
        "@tiptap/starter-kit": "3.31.3",
        "@tiptap/vue-3": "3.31.3",
        "@vueuse/core": "^12.0.0",
        "axios": "^1.12.0",
        "date-fns": "^4.1.0",
        "markdown-it": "^14.1.0",
        "pinia": "^2.2.6",
        "vue": "3.5.42",
        "vue-router": "^4.4.5",
        "vuetify": "4.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.14.0",
        "@playwright/test": "^1.49.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vitest/coverage-v8": "3.2.7",
        "@vitest/eslint-plugin": "1.1.10",
        "@vue/eslint-config-prettier": "^10.1.0",
        "@vue/test-utils": "^2.4.6",
        "eslint": "^9.14.0",
        "eslint-plugin-playwright": "^2.1.0",
        "eslint-plugin-vue": "^9.30.0",
        "eslint-plugin-vuetify": "2.7.2",
        "jsdom": "^25.0.1",
        "prettier": "^3.3.3",
        "sass": "^1.77.8",
        "stylelint": "^16.20.0",
        "stylelint-config-recommended-vue": "^1.6.0",
        "stylelint-config-standard": "^38.0.0",
        "vite": "^6.0.1",
        "vite-plugin-vue-devtools": "^7.6.5",
        "vite-plugin-vuetify": "2.1.3",
        "vitest": "^3.2.1"
    }
}
