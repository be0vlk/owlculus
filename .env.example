# Owlculus Docker Compose configuration
# Fresh installs: make setup generates .env with random secrets automatically.
# Manual configuration: copy this file to .env, then fill in the three secrets
# below before starting production. Run `openssl rand -hex 32` separately for
# each new secret; paste the output as the value (commands are not evaluated).
# Set up production: make setup
# Set up development: make setup-dev
# Development supplies local-only defaults when secret values are empty.
#
# Existing installs: merge missing settings into your existing .env; do not
# overwrite it. Preserve SECRET_KEY, database names, and existing passwords.
# Changing a password here does not rotate an existing database login.
# If make setup reports a missing RUNTIME_POSTGRES_PASSWORD on upgrade:
# 1. Run: openssl rand -hex 32
# 2. Edit the existing .env in the repository root. Add the runtime username
#    and paste the generated output after RUNTIME_POSTGRES_PASSWORD=.
#    If the runtime login already exists, use its existing password instead.
# 3. Save .env and rerun: make setup

# REQUIRED in production: signing/encryption secret. Keep stable across upgrades.
SECRET_KEY=

# Database owner: creates the database and runs initialization/migrations.
# These credentials are used by postgres and db-init, not the app/workers.
POSTGRES_USER=owlculus
POSTGRES_PASSWORD=
POSTGRES_DB=owlculus

# Restricted login for the app and workers, accessing the SAME database.
# Can read/write application data, but cannot manage the schema or roles.
# The username must differ from POSTGRES_USER. db-init creates this login.
# When upgrading without a runtime login, generate a new password for it.
# If the login already exists, use its existing password.
RUNTIME_POSTGRES_USER=owlculus_runtime
RUNTIME_POSTGRES_PASSWORD=

# Production web access through Caddy. :80 serves HTTP without a hostname.
# For automatic HTTPS, set DOMAIN to your public hostname (no scheme/path),
# point its DNS at this server, and make ports 80 and 443 reachable.
DOMAIN=:80
FRONTEND_PORT=80
HTTPS_PORT=443

# Development only: host ports and Vite's allowed hostname.
# Database/backend ports are not published in production.
# Loopback binding keeps development services accessible only on this machine.
DEV_BIND_HOST=127.0.0.1
DEV_HOST=localhost
DEV_FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_PORT=5432
# FRONTEND_URL=http://localhost:5173
# OWLCULUS_LOG_FILE=logs/owlculus.log

# Optional capacity settings (shown with the Compose defaults).
# API_WORKERS=1
# API_DATABASE_CONCURRENCY=8
# API_DATABASE_POOL_SIZE=5
# API_DATABASE_MAX_OVERFLOW=5
# PLUGIN_CONCURRENCY=2
# HUNT_CONCURRENCY=2
# PLUGIN_WORKER_MEMORY=1g
# HUNT_WORKER_MEMORY=1g
# WORKER_DATABASE_POOL_SIZE=2
# WORKER_DATABASE_MAX_OVERFLOW=0
# REDIS_MAXMEMORY=256mb
# AUTH_REDIS_MAXMEMORY=32mb

# Optional login throttling and execution admission limits.
# LOGIN_IP_MAX_ATTEMPTS=30
# LOGIN_ACCOUNT_MAX_ATTEMPTS=10
# LOGIN_LIMIT_WINDOW_SECONDS=300
# EXECUTION_LIMIT_GLOBAL=1000
# EXECUTION_LIMIT_CASE=100
# EXECUTION_LIMIT_USER=25

# Compose already sets internal database/Redis addresses and trusted proxy IPs.
# Additional worker limits and service overrides are listed in docker-compose.yml.
